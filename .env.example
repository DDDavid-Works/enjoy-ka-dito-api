PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=enjoykadito

JWT_SECRET=change-me-to-a-long-random-string

# Hosted deployment (e.g. Railway). DATABASE_URL, when set, replaces the DB_* values above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_SSL=true            # only if the database requires SSL
# DB_SYNCHRONIZE=true    # create tables on first boot, then remove or set to false
# CORS_ORIGIN=https://your-site.example.com   # comma-separated; unset allows any origin

# Next.js site (web/) to notify when packages or company details change, so its cache refreshes at once.
# Both must be set, and REVALIDATE_SECRET must match the web service. Leave unset to skip.
# WEB_URL=https://your-next-site.example.com
# REVALIDATE_SECRET=change-me-to-a-long-random-string

# Spam protection (reCAPTCHA v3). Leave RECAPTCHA_SECRET unset to skip the check (local development).
# RECAPTCHA_SECRET=
# RECAPTCHA_MIN_SCORE=0.5

# Email the team on each new inquiry, through Resend. Both must be set; leave unset to skip.
# RESEND_API_KEY=
# INQUIRY_NOTIFY_TO=sales@example.com            # comma-separated
# INQUIRY_EMAIL_FROM=Enjoy Ka Dito <noreply@your-verified-domain>   # default: Resend's test sender
