{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsc -b && concurrently -k -n tsc,node \"tsc -b -w --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "seed:admin": "tsc -b && node dist/seed-admin.js",
    "seed:packages": "tsc -b && node dist/seed-packages.js",
    "seed:hotels": "tsc -b && node dist/seed-hotels.js",
    "lint": "oxlint"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/typeorm": "^12.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/passport-jwt": "^4.0.1",
    "concurrently": "^9.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
